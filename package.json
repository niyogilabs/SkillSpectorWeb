{
  "name": "skillspector-web",
  "version": "2.12.0",
  "description": "A client-side browser port of SkillSpector maintained for user convenience to inspect AI agent skills hosted on GitHub",
  "main": "docs/index.html",
  "scripts": {
    "start": "python3 server.py 8080",
    "dev": "python3 server.py 8080",
    "test": "node tests/test_equivalence.js",
    "test:cross": "python3 tests/compare_python_vs_wasm.py",
    "prepare": "mkdir -p .git/hooks && cp .githooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit"
  },
  "keywords": [
    "security",
    "ai-agents",
    "vulnerability-scanner",
    "browser",
    "javascript",
    "github"
  ],
  "author": "Community Maintainers",
  "license": "Apache-2.0"
}
